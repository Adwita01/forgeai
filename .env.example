# Any OpenAI-compatible endpoint. Default: local Ollama.
FORGE_BASE_URL=http://localhost:11434/v1
FORGE_API_KEY=ollama
FORGE_MODEL=qwen2.5:3b
# Optional separate judge model (reduces self-preference bias). Empty = same as FORGE_MODEL.
FORGE_JUDGE_MODEL=
# Embedding model for the dense half of hybrid retrieval. Empty or unreachable = TF-IDF fallback.
FORGE_EMBED_MODEL=nomic-embed-text
FORGE_TEMPERATURE=0.1
FORGE_REQUEST_TIMEOUT=300
FORGE_MAX_RETRIES=3

# Budget per `forge build` run (0 = unlimited)
FORGE_MAX_TOKENS=0
FORGE_MAX_SECONDS=0
# Early stop when an optimizer iteration improves the pass rate by less than this
FORGE_MIN_GAIN=0.02
